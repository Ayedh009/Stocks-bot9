name: overnight

on:
  schedule:
    - cron: "25 19,20 * * 1-5"   # الترشيح 3:25 م نيويورك (صيفي/شتوي)
    - cron: "20 20,21 * * 1-5"   # فحص بعد الإغلاق 4:20 م
    - cron: "0 13,14 * * 1-5"    # فحص قبل الافتتاح 9:00 ص
    - cron: "50 13,14 * * 1-5"   # النتائج 9:50 ص
  workflow_dispatch:
    inputs:
      mode:
        description: "auto | pick | after | pre | result | stats"
        default: "auto"

permissions:
  contents: write

concurrency:
  group: overnight
  cancel-in-progress: false

jobs:
  run:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install yfinance requests
      - name: Run overnight
        env:
          BOT_TOKEN: ${{ secrets.BOT_TOKEN }}
          CHAT_ID: ${{ secrets.CHAT_ID }}
        run: python overnight.py ${{ github.event.inputs.mode || 'auto' }}
      - name: Save state
        run: |
          git config user.name "overnight-bot"
          git config user.email "overnight-bot@users.noreply.github.com"
          git add overnight_state.json stats/overnight_log.csv 2>/dev/null || true
          if ! git diff --cached --quiet; then
            git commit -m "overnight state"
            git pull --rebase
            git push
          fi
